{% extends "layouts/main.html" %}

{% block pageTitle %}
Remove case note
{% endblock %}

{% block beforeContent %}
    {{ govukBackLink({ text: "Back", href: backUrl }) }}
{% endblock %}

{% block content %}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">

            <h1 class="govuk-heading-l govuk-!-margin-bottom-3">Remove case note</h1>

            <p class="govuk-body govuk-!-margin-bottom-4">This will remove the case note from the manage case view. The content of this note will still be visible in the case history.</p>

            {{ govukInsetText({ text: noteText }) }}

            <form action="{{ actionUrl }}" method="post" novalidate>
                {{ govukButton({ text: "Remove note", classes: "govuk-button--warning" }) }}
            </form>

            <p class="govuk-body govuk-!-margin-top-2">
                <a class="govuk-link" href="{{ backUrl }}">Cancel</a>
            </p>

        </div>
    </div>
{% endblock %}