{% raw %}
  <script>
    (function () {
      var BASE = '/features-and-components/costs-applications/v1/';
      var CASE_REF = 'SOS/ENG/10001';
      var STORE = 'costsApplicationsV1';
      var DRAFT = 'costsApplicationsV1Draft';

      var PARTIES = ['Northbridge Borough Council', 'Greenfield Developments Ltd', 'Oak Valley Residents Association', 'Aisha Rahman', 'Sophie Williams'];
      var INSPECTORS = ['Carol Danvers', 'Jean Grey', 'Peter Parker', 'Natasha Romanoff'];
      var MONTHS = [
        'January',
        'February',
        'March',
        'April',
        'May',
        'June',
        'July',
        'August',
        'September',
        'October',
        'November',
        'December'
      ];

      /* ---------- storage ---------- */
      function seed() {
        return [
          {
            id: 'CA-0003',
            dateMade: '2026-10-07',
            applicants: ['Northbridge Borough Council'],
            respondents: ['Greenfield Developments Ltd'],
            commentsReceived: '2026-10-10',
            decisionMakerType: 'Inspector',
            inspectorName: 'Carol Danvers',
            outcomeType: 'Decision only',
            reportRequired: 'No',
            decisionIssued: '2026-10-15',
            outcome: 'Costs granted'
          }, {
            id: 'CA-0002',
            dateMade: '2026-07-07',
            applicants: [
              'Aisha Rahman', 'Sophie Williams'
            ],
            respondents: ['Northbridge Borough Council'],
            decisionMakerType: 'Costs Branch',
            outcomeType: 'Decision only',
            reportRequired: 'No',
            decisionIssued: '2026-08-01',
            outcome: 'Costs refused'
          }, {
            id: 'CA-0001',
            dateMade: '2026-09-16',
            applicants: ['Oak Valley Residents Association'],
            respondents: [
              'Greenfield Developments Ltd', 'Northbridge Borough Council'
            ],
            withdrawn: 'Yes',
            withdrawalDate: '2026-09-30',
            withdrawalReason: 'Matter resolved between the parties.'
          }
        ];
      }
      function all() {
        var raw = localStorage.getItem(STORE);
        if (!raw) {
          localStorage.setItem(STORE, JSON.stringify(seed()));
          raw = localStorage.getItem(STORE);
        }
        return JSON.parse(raw);
      }
      function saveAll(list) {
        localStorage.setItem(STORE, JSON.stringify(list));
      }
      function find(id) {
        return all().filter(function (a) {
          return a.id === id;
        })[0];
      }
      function update(rec) {
        saveAll(all().map(function (a) {
          return a.id === rec.id
            ? rec
            : a;
        }));
      }
      function nextId() {
        var max = all().reduce(function (m, a) {
          return Math.max(m, parseInt(a.id.split('-')[1], 10));
        }, 0);
        return 'CA-' + (
        '0000' + (
        max + 1)).slice(-4);
      }
      function getDraft() {
        return JSON.parse(sessionStorage.getItem(DRAFT) || '{}');
      }
      function setDraft(d) {
        sessionStorage.setItem(DRAFT, JSON.stringify(d));
      }

      /* ---------- helpers ---------- */
      function esc(s) {
        return String(
          s == null
          ? ''
          : s).replace(/[&<>"']/g, function (c) {
          return {'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'}[c];
        });
      }
      function qs(name) {
        return new URLSearchParams(location.search).get(name);
      }
      function iso(y, m, d) {
        return y + '-' + (
        '0' + m).slice(-2) + '-' + (
        '0' + d).slice(-2);
      }
      function fmt(s) {
        if (!s) 
          return '';
        var p = s.split('-');
        return parseInt(p[2], 10) + ' ' + MONTHS[parseInt(p[1], 10) - 1] + ' ' + p[0];
      }
      function todayIso() {
        var t = new Date();
        return iso(t.getFullYear(), t.getMonth() + 1, t.getDate());
      }
      function list(arr) {
        return (arr || [])
          .map(esc)
          .join('<br>');
      }

      function status(a) {
        if (a.withdrawn === 'Yes') 
          return {text: 'Withdrawn', cls: 'govuk-tag--grey'};
        if (a.outcome) 
          return {text: 'Decided', cls: 'govuk-tag--green'};
        var started = [
          'deadline',
          'commentsReceived',
          'commentsShared',
          'finalCommentsReceived',
          'decisionMakerType',
          'reportRequired',
          'reportIssued',
          'decisionIssued'
        ].some(function (k) {
          return a[k];
        });
        return started
          ? {
            text: 'In progress',
            cls: 'govuk-tag--blue'
          }
          : {
            text: 'Draft',
            cls: 'govuk-tag--light-blue'
          };
      }
      function tag(a) {
        var s = status(a);
        return '<strong class="govuk-tag ' + s.cls + '">' + s.text + '</strong>';
      }

      /* ---------- validation (user story business rules) ---------- */
      var LABEL = {
        dateMade: 'date the application was submitted',
        withdrawalDate: 'withdrawal date',
        deadline: 'deadline for comments',
        commentsReceived: 'date comments were received',
        finalCommentsReceived: 'date final comments were received',
        reportIssued: 'date the report was issued',
        decisionIssued: 'date the decision was issued'
      };
      function validate(a) {
        var e = {},
          today = todayIso();
        ['dateMade', 'withdrawalDate', 'reportIssued', 'decisionIssued'].forEach(function (k) {
          if (a[k] && a[k] > today) 
            e[k] = 'The ' + LABEL[k] + ' must be today or in the past';
          }
        );
        if (a.withdrawn === 'Yes' && !a.withdrawalDate) 
          e.withdrawalDate = 'Enter the withdrawal date';
        function cmp(x, y, strict, msgY, msgX) {
          if (a[x] && a[y] && (
            strict
            ? a[x] >= a[y]
            : a[x] > a[y])) {
            if (!e[y]) 
              e[y] = msgY;
            if (!e[x]) 
              e[x] = msgX;
            }
          }
        var hasReport = a.reportRequired === 'Yes';
        cmp('dateMade', 'deadline', false, 'The deadline for comments must be on or after the date the application was submitted', 'The date submitted must be on or before the deadline for comments');
        cmp('dateMade', 'commentsReceived', false, 'The date comments were received must be on or after the date the application was submitted', 'The date submitted must be on or before the date comments were received');
        cmp('commentsReceived', 'finalCommentsReceived', true, 'The date final comments were received must be after the date comments were received', 'The date comments were received must be before the date final comments were received');
        cmp('dateMade', 'reportIssued', false, 'The date the report was issued must be on or after the date the application was submitted', 'The date submitted must be on or before the date the report was issued');
        cmp('dateMade', 'decisionIssued', false, 'The date the decision was issued must be on or after the date the application was submitted', 'The date submitted must be on or before the date the decision was issued');
        if (hasReport) {
          cmp('commentsReceived', 'reportIssued', false, 'The date the report was issued must be on or after the date comments were received', 'The date comments were received must be on or before the date the report was issued');
          cmp('finalCommentsReceived', 'reportIssued', false, 'The date the report was issued must be on or after the date final comments were received', 'The date final comments were received must be on or before the date the report was issued');
          cmp('reportIssued', 'decisionIssued', false, 'The date the decision was issued must be on or after the date the report was issued', 'The date the report was issued must be on or before the date the decision was issued');
        }
        cmp('commentsReceived', 'decisionIssued', false, 'The date the decision was issued must be on or after the date comments were received', 'The date comments were received must be on or before the date the decision was issued');
        cmp('finalCommentsReceived', 'decisionIssued', false, 'The date the decision was issued must be on or after the date final comments were received', 'The date final comments were received must be on or before the date the decision was issued');
        return e;
      }

      /* ---------- question pages ---------- */
      var OUTCOMES = ['Costs granted', 'Costs refused', 'Costs partially awarded'];
      var PAGES = {
        dateMade: {
          title: 'What is the date the application was submitted?',
          inputs: [
            {
              key: 'dateMade',
              type: 'date',
              required: 'Enter the date the application was submitted',
              hint: 'For example, 6 2 2026'
            }
          ]
        },
        applicants: {
          title: 'Who is the applicant?',
          inputs: [
            {
              key: 'applicants',
              type: 'parties',
              hint: 'Select all that apply.',
              required: 'Select at least one applicant'
            }
          ]
        },
        respondents: {
          title: 'Who is the respondent?',
          inputs: [
            {
              key: 'respondents',
              type: 'parties',
              hint: 'Select all that apply.',
              required: 'Select at least one respondent'
            }
          ]
        },
        deadline: {
          title: 'What is the deadline for comments?',
          inputs: [
            {
              key: 'deadline',
              type: 'date',
              hint: 'For example, 6 2 2026'
            }
          ]
        },
        commentsReceived: {
          title: 'What date were comments received?',
          inputs: [
            {
              key: 'commentsReceived',
              type: 'date',
              hint: 'For example, 6 2 2026'
            }
          ]
        },
        commentsShared: {
          title: 'What date were the comments shared?',
          inputs: [
            {
              key: 'commentsShared',
              type: 'date',
              hint: 'The date comments were cross-copied to the other party. For example, 6 2 2026'
            }
          ]
        },
        finalCommentsReceived: {
          title: 'What date were final comments received?',
          inputs: [
            {
              key: 'finalCommentsReceived',
              type: 'date',
              hint: 'For example, 6 2 2026'
            }
          ]
        },
        decisionMakerType: {
          title: 'Who is the decision maker?',
          inputs: [
            {
              key: 'decisionMakerType',
              type: 'radios',
              options: ['Inspector', 'Costs Branch', 'Secretary of State']
            }
          ]
        },
        inspectorName: {
          title: 'Which inspector?',
          inputs: [
            {
              key: 'inspectorName',
              type: 'select',
              options: INSPECTORS,
              required: 'Select an inspector'
            }
          ]
        },
        outcomeType: {
          title: 'What type of cost outcome is this?',
          inputs: [
            {
              key: 'outcomeType',
              type: 'radios',
              options: ['Decision only', 'Report and decision']
            }
          ]
        },
        reportRequired: {
          title: 'Is a costs report required?',
          inputs: [
            {
              key: 'reportRequired',
              type: 'radios',
              options: [
                'Yes', 'No'
              ],
              required: 'Select whether a costs report is required'
            }
          ]
        },
        reportIssued: {
          title: 'What date was the report issued?',
          inputs: [
            {
              key: 'reportIssued',
              type: 'date',
              hint: 'For example, 6 2 2026'
            }
          ]
        },
        reportAuthor: {
          title: 'Who is the report author?',
          inputs: [
            {
              key: 'reportAuthor',
              type: 'select',
              options: INSPECTORS
            }
          ]
        },
        finalComments: {
          title: 'Final comments',
          inputs: [
            {
              key: 'finalComments',
              type: 'textarea',
              hint: 'Record the final comments received.'
            }
          ]
        },
        comments: {
          title: 'Comments',
          inputs: [
            {
              key: 'comments',
              type: 'textarea',
              hint: 'General notes about this application.'
            }
          ]
        },
        decisionIssued: {
          title: 'What date was the decision issued?',
          inputs: [
            {
              key: 'decisionIssued',
              type: 'date',
              hint: 'For example, 6 2 2026'
            }
          ]
        },
        decisionAuthor: {
          title: 'Who is the decision author?',
          inputs: [
            {
              key: 'decisionAuthor',
              type: 'select',
              options: INSPECTORS
            }
          ]
        },
        outcome: {
          title: 'What was the outcome?',
          inputs: [
            {
              key: 'outcome',
              type: 'radios',
              options: OUTCOMES,
              required: 'Select the outcome'
            }
          ]
        },
        withdrawal: {
          title: 'Has the costs application been withdrawn?',
          inputs: [
            {
              key: 'withdrawn',
              type: 'radios',
              options: [
                'Yes', 'No'
              ],
              required: 'Select whether the application has been withdrawn',
              conditional: {
                Yes: [
                  {
                    key: 'withdrawalDate',
                    type: 'date',
                    label: 'Withdrawal date',
                    hint: 'For example, 6 2 2026'
                  }, {
                    key: 'withdrawalReason',
                    type: 'textarea',
                    label: 'Reason for withdrawal (optional)'
                  }
                ]
              }
            }
          ]
        }
      };

      function dateVal(a, k, part) {
        var v = a[k];
        if (!v) 
          return '';
        return v
          .split('-')[
            {
              y: 0,
              m: 1,
              d: 2
            }[part]]
          .replace(/^0/, '');
      }
      function errMsg(errors, key) {
        return errors[key]
          ? '<p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> ' + esc(errors[key]) + '</p>'
          : '';
      }

      function renderInput(inp, a, errors, isOnly, title) {
        var k = inp.key,
          err = errors[k],
          hasErr = err
            ? ' govuk-form-group--error'
            : '';
        var label = inp.label || title;
        var legendCls = isOnly
          ? 'govuk-fieldset__legend--l'
          : 'govuk-fieldset__legend--s';
        var legendInner = isOnly
          ? '<h1 class="govuk-fieldset__heading">' + esc(label) + '</h1>'
          : esc(label);
        var hint = inp.hint
          ? '<div id="' + k + '-hint" class="govuk-hint">' + esc(inp.hint) + '</div>'
          : '';
        var h = '';
        if (inp.type === 'date') {
          var ec = err
            ? ' govuk-input--error'
            : '';
          h = '<div class="govuk-form-group' + hasErr + '"><fieldset class="govuk-fieldset" role="group"><legend class="govuk-fieldset__legend ' + legendCls + '">' + legendInner + '</legend>' + hint + errMsg(errors, k) + '<div class="govuk-date-input" id="' + k + '">' + [
            [
              'd', 'Day', 2
            ],
            [
              'm', 'Month', 2
            ],
            [
              'y', 'Year', 4
            ]
          ]
            .map(function (p) {
              return '<div class="govuk-date-input__item"><div class="govuk-form-group"><label class="govuk-label govuk-date-input__label" for="' + k + '-' + p[0] + '">' + p[1] + '</label>' + '<input class="govuk-input govuk-date-input__input govuk-input--width-' + p[2] + ec + '" id="' + k + '-' + p[0] + '" name="' + k + '-' + p[0] + '" type="text" inputmode="numeric" value="' + esc(dateVal(a, k, p[0])) + '"></div></div>';
            })
            .join('') + '</div></fieldset></div>';
        } else if (inp.type === 'textarea') {
          h = '<div class="govuk-form-group' + hasErr + '"><h1 class="' + (
            isOnly
            ? 'govuk-label-wrapper'
            : '') + '"><label class="govuk-label ' + (
            isOnly
            ? 'govuk-label--l'
            : 'govuk-label--s') + '" for="' + k + '">' + esc(label) + '</label></h1>' + hint + errMsg(errors, k) + '<textarea class="govuk-textarea' + (
            err
            ? ' govuk-textarea--error'
            : '') + '" id="' + k + '" name="' + k + '" rows="5">' + esc(a[k]) + '</textarea></div>';
        } else if (inp.type === 'select') {
          h = '<div class="govuk-form-group' + hasErr + '"><h1 class="govuk-label-wrapper"><label class="govuk-label govuk-label--l" for="' + k + '">' + esc(label) + '</label></h1>' + hint + errMsg(errors, k) + '<select class="govuk-select' + (
            err
            ? ' govuk-select--error'
            : '') + '" id="' + k + '" name="' + k + '"><option value="">Select</option>' + inp
            .options
            .map(function (o) {
              return '<option' + (
                a[k] === o
                ? ' selected'
                : '') + '>' + esc(o) + '</option>';
            })
            .join('') + '</select></div>';
        } else if (inp.type === 'radios') {
          h = '<div class="govuk-form-group' + hasErr + '"><fieldset class="govuk-fieldset"><legend class="govuk-fieldset__legend ' + legendCls + '">' + legendInner + '</legend>' + hint + errMsg(errors, k) + '<div class="govuk-radios" data-module="govuk-radios" id="' + k + '">' + inp
            .options
            .map(function (o, i) {
              var cond = inp.conditional && inp.conditional[o];
              var id = k + '-' + i;
              return '<div class="govuk-radios__item"><input class="govuk-radios__input" id="' + id + '" name="' + k + '" type="radio" value="' + esc(o) + '"' + (
                a[k] === o
                ? ' checked'
                : '') + (
                cond
                ? ' data-aria-controls="c-' + id + '"'
                : '') + '>' + '<label class="govuk-label govuk-radios__label" for="' + id + '">' + esc(o) + '</label></div>' + (
                cond
                ? '<div class="govuk-radios__conditional govuk-radios__conditional--hidden" id="c-' + id + '">' + cond.map(function (c) {
                  return renderInput(c, a, errors, false, c.label);
                }).join('') + '</div>'
                : '');
            })
            .join('') + '</div></fieldset></div>';
        } else if (inp.type === 'parties') {
          var sel = a[k] || [];
          var extra = sel.filter(function (p) {
            return PARTIES.indexOf(p) < 0;
          })[0] || '';
          h = '<div class="govuk-form-group' + hasErr + '"><fieldset class="govuk-fieldset" aria-describedby="' + k + '-hint"><legend class="govuk-fieldset__legend ' + legendCls + '">' + legendInner + '</legend>' + hint + errMsg(errors, k) + '<div class="govuk-checkboxes" data-module="govuk-checkboxes" id="' + k + '">' + PARTIES
            .map(function (p, i) {
              return '<div class="govuk-checkboxes__item"><input class="govuk-checkboxes__input" id="' + k + '-' + i + '" name="' + k + '" type="checkbox" value="' + esc(p) + '"' + (
                sel.indexOf(p) > -1
                ? ' checked'
                : '') + '>' + '<label class="govuk-label govuk-checkboxes__label" for="' + k + '-' + i + '">' + esc(p) + '</label></div>';
            })
            .join('') + '<div class="govuk-checkboxes__divider">or</div>' + '<div class="govuk-checkboxes__item"><input class="govuk-checkboxes__input" id="' + k + '-other" name="' + k + '-other-check" type="checkbox" data-aria-controls="c-' + k + '-other"' + (
            extra
            ? ' checked'
            : '') + '>' + '<label class="govuk-label govuk-checkboxes__label" for="' + k + '-other">Not already a party on this case</label></div>' + '<div class="govuk-checkboxes__conditional govuk-checkboxes__conditional--hidden" id="c-' + k + '-other"><div class="govuk-form-group"><label class="govuk-label" for="' + k + '-name">Name of person or organisation</label>' + '<input class="govuk-input govuk-!-width-two-thirds" id="' + k + '-name" name="' + k + '-name" type="text" value="' + esc(extra) + '"></div></div>' + '</div></fieldset></div>';
        }
        return h;
      }

      function readInput(inp, form, out, errors) {
        var k = inp.key;
        if (inp.type === 'date') {
          var d = form[k + '-d']
              .value
              .trim(),
            m = form[k + '-m']
              .value
              .trim(),
            y = form[k + '-y']
              .value
              .trim();
          if (!d && !m && !y) {
            out[k] = '';
            if (inp.required) 
              errors[k] = inp.required;
            return;
          }
          var missing = [
            !d && 'day',
            !m && 'month',
            !y && 'year'
          ].filter(Boolean);
          if (missing.length) {
            errors[k] = 'The date must include a ' + missing.join(' and ');
            return;
          }
          var dt = new Date(+ y, + m - 1, + d);
          if (!/^\d+$/.test(d + m + y) || y.length !== 4 || dt.getDate() !== + d || dt.getMonth() !== + m - 1) {
            errors[k] = 'The date must be a real date';
            return;
          }
          out[k] = iso(y, m, d);
        } else if (inp.type === 'parties') {
          var vals = Array
            .prototype
            .slice
            .call(form.querySelectorAll('input[name="' + k + '"]:checked'))
            .map(function (i) {
              return i.value;
            });
          var other = form[k + '-other-check'].checked
            ? form[k + '-name']
              .value
              .trim()
            : '';
          if (form[k + '-other-check'].checked && !other) {
            errors[k] = 'Enter the name of the person or organisation';
            return;
          }
          if (other) 
            vals.push(other);
          out[k] = vals;
          if (!vals.length) 
            errors[k] = inp.required;
          }
        else if (inp.type === 'radios') {
          var c = form.querySelector('input[name="' + k + '"]:checked');
          out[k] = c
            ? c.value
            : '';
          if (!out[k] && inp.required) {
            errors[k] = inp.required;
            return;
          }
          if (inp.conditional) 
            Object
              .keys(inp.conditional)
              .forEach(function (opt) {
                inp
                  .conditional[opt]
                  .forEach(function (ci) {
                    if (out[k] === opt) 
                      readInput(ci, form, out, errors);
                    else 
                      out[ci.key] = '';
                    }
                  );
              });
          }
        else {
          out[k] = form[k]
            .value
            .trim();
          if (!out[k] && inp.required) 
            errors[k] = inp.required;
          }
        }

      function errorSummary(errors, keys) {
        var ks = Object
          .keys(errors)
          .filter(function (k) {
            return keys.indexOf(k) > -1;
          });
        if (!ks.length) 
          return '';
        return '<div class="govuk-error-summary" data-module="govuk-error-summary"><div role="alert"><h2 class="govuk-error-summary__title">There is a problem</h2><div class="govuk-error-summary__body"><ul class="govuk-list govuk-error-summary__list">' + ks
          .map(function (k) {
            var target = k + (
              /Date|deadline|Received|Issued|dateMade|commentsShared/.test(k) && k !== 'inspectorName'
              ? '-d'
              : '');
            return '<li><a href="#' + target + '">' + esc(errors[k]) + '</a></li>';
          })
          .join('') + '</div></div></div>';
      }

      function flatKeys(page) {
        var ks = [];
        page
          .inputs
          .forEach(function (i) {
            ks.push(i.key);
            if (i.conditional) 
              Object
                .keys(i.conditional)
                .forEach(function (o) {
                  i
                    .conditional[o]
                    .forEach(function (c) {
                      ks.push(c.key);
                    });
                });
            }
          );
        return ks;
      }

      /* mode: 'create' (draft, flow = sequence) or 'edit' (existing record) */
      function questionPage(root, pageKey, opts) {
        var page = PAGES[pageKey],
          keys = flatKeys(page);
        var rec = opts.mode === 'edit'
          ? find(opts.id)
          : getDraft();
        if (!rec) {
          location.href = BASE + 'case';
          return;
        }
        var errors = {};

        function draw(a) {
          var one = page.inputs.length === 1;
          var inner = page
            .inputs
            .map(function (i) {
              return renderInput(i, a, errors, one, page.title);
            })
            .join('');
          if (!one) 
            inner = '<h1 class="govuk-heading-l">' + esc(page.title) + '</h1>' + inner;
          root.innerHTML = '<div class="govuk-grid-row"><div class="govuk-grid-column-two-thirds">' + errorSummary(errors, keys) + '<span class="govuk-caption-l">' + esc(CASE_REF) + (
            opts.mode === 'edit'
            ? ' · ' + esc(rec.id)
            : '') + '</span>' + '<form novalidate>' + inner + '<div class="govuk-button-group"><button class="govuk-button" data-module="govuk-button">' + (
            opts.mode === 'edit'
            ? 'Save'
            : 'Continue') + '</button></div></form></div></div>';
          if (window.GOVUKFrontend && GOVUKFrontend.initAll) {
            try {
              GOVUKFrontend.initAll({scope: root});
            } catch (e) {}
          }
          var form = root.querySelector('form');
          form.addEventListener('submit', function (ev) {
            ev.preventDefault();
            var out = {};
            errors = {};
            page
              .inputs
              .forEach(function (i) {
                readInput(i, form, out, errors);
              });
            var next = Object.assign({}, rec, out);
            if (!Object.keys(errors).length) {
              var rule = validate(next);
              keys.forEach(function (k) {
                if (rule[k]) 
                  errors[k] = rule[k];
                }
              );
            }
            if (Object.keys(errors).length) {
              draw(next);
              window.scrollTo(0, 0);
              return;
            }
            opts.onSave(next);
          });
        }
        draw(rec);
      }

      /* ---------- summary page ---------- */
      function row(a, label, key, value, pageKey) {
        var v = value === undefined
          ? a[key]
          : value;
        var shown = v
          ? v
          : '-';
        return '<div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">' + esc(label) + '</dt><dd class="govuk-summary-list__value">' + shown + '</dd>' + '<dd class="govuk-summary-list__actions"><a class="govuk-link" href="' + BASE + 'edit?id=' + a.id + '&page=' + pageKey + '">Change<span class="govuk-visually-hidden"> ' + esc(label.toLowerCase()) + '</span></a></dd></div>';
      }
      function partyList(arr) {
        arr = arr || [];
        if (arr.length < 2) 
          return list(arr);
        var li = function (p, hide) {
          return '<li' + (
            hide
            ? ' class="costs-party-more" hidden'
            : '') + '>' + esc(p) + '</li>';
        };
        var h = '<ul class="govuk-list govuk-list--bullet govuk-!-margin-bottom-0">' + arr
          .map(function (p, i) {
            return li(p, i > 2);
          })
          .join('') + '</ul>';
        if (arr.length > 3) {
          var n = arr.length - 3;
          h += '<a href="#" class="govuk-link costs-party-toggle" data-more="View ' + n + ' more" data-less="View less" aria-expanded="false">View ' + n + ' more</a>';
        }
        return h;
      }
      function partyRow(a, label, key) {
        return '<div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">' + label + '</dt><dd class="govuk-summary-list__value">' + partyList(a[key]) + '</dd><dd class="govuk-summary-list__actions"><a class="govuk-link" href="' + BASE + 'party-manage?id=' + a.id + '&key=' + key + '">Change<span class="govuk-visually-hidden"> ' + label.toLowerCase() + '</span></a></dd></div>';
      }
      function section(title, rows) {
        return '<h2 class="govuk-heading-m govuk-!-margin-top-8">' + title + '</h2><dl class="govuk-summary-list">' + rows.join('') + '</dl>';
      }

      function viewPage(root) {
        var a = find(qs('id'));
        if (!a) {
          root.innerHTML = '<p class="govuk-body">Costs application not found.</p>';
          return;
        }
        var wasJustCreated = qs('created');
        var withdrawn = a.withdrawn === 'Yes',
          rows;
        var h = '';
        if (wasJustCreated) 
          h += '<div class="govuk-notification-banner govuk-notification-banner--success" role="alert" data-module="govuk-notification-banner"><div class="govuk-notification-banner__header"><h2 class="govuk-notification-banner__title">Success</h2></div><div class="govuk-notification-banner__content"><h3 class="govuk-notification-banner__heading">Costs application ' + esc(a.id) + ' created</h3></div></div>';
        h += '<span class="govuk-caption-l">' + esc(CASE_REF) + '</span><h1 class="govuk-heading-l">Costs application ' + esc(a.id) + '</h1><p class="govuk-body">' + tag(a) + '</p>';
        h += section('Application details', [
          '<div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">Costs application reference</dt><dd class="govuk-summary-list__value">' + esc(a.id) + '</dd><dd class="govuk-summary-list__actions"></dd></div>',

          partyRow(a, 'Applicants', 'applicants'),
          partyRow(a, 'Respondents', 'respondents'),
          row(a, 'Date submitted', 'dateMade', fmt(a.dateMade), 'dateMade')
        ]);
        if (!withdrawn) {
          h += section('Comment exchange', [
            row(a, 'Deadline for comments', 'deadline', fmt(a.deadline), 'deadline'),
            row(a, 'Date comments received', 'commentsReceived', fmt(a.commentsReceived), 'commentsReceived'),
            row(a, 'Date comments shared', 'commentsShared', fmt(a.commentsShared), 'commentsShared'),
            row(a, 'Date final comments received', 'finalCommentsReceived', fmt(a.finalCommentsReceived), 'finalCommentsReceived')
          ]);
          var dm = [row(a, 'Decision maker type', 'decisionMakerType', esc(a.decisionMakerType), 'decisionMakerType')];
          if (a.decisionMakerType === 'Inspector' || a.reportAuthor || a.decisionAuthor) 
            dm.push(row(a, 'Inspector name', 'inspectorName', esc(a.inspectorName), 'inspectorName'));
          dm.push(row(a, 'Cost outcome type', 'outcomeType', esc(a.outcomeType), 'outcomeType'));
          h += section('Decision maker', dm);
          var rep = [row(a, 'Cost report required', 'reportRequired', esc(a.reportRequired), 'reportRequired')];
          if (a.reportRequired === 'Yes') 
            rep.push(row(a, 'Date report issued', 'reportIssued', fmt(a.reportIssued), 'reportIssued'), row(a, 'Report author', 'reportAuthor', esc(a.reportAuthor), 'reportAuthor'));
          h += section('Report', rep);
          h += section('Decision', [
            row(a, 'Final comments', 'finalComments', esc(a.finalComments), 'finalComments'),
            row(a, 'Date decision issued', 'decisionIssued', fmt(a.decisionIssued), 'decisionIssued'),
            row(a, 'Decision author', 'decisionAuthor', esc(a.decisionAuthor), 'decisionAuthor'),
            row(a, 'Decision type', 'decisionMakerType', esc(
              a.decisionMakerType
              ? a.decisionMakerType + ' decision'
              : ''), 'decisionMakerType'),
            row(a, 'Outcome', 'outcome', esc(a.outcome), 'outcome')
          ]);
        }
        h += section('Withdrawal', [row(a, 'Withdrawn', 'withdrawn', esc(a.withdrawn || 'No'), 'withdrawal')].concat(
          withdrawn
          ? [
            row(a, 'Withdrawal date', 'withdrawalDate', fmt(a.withdrawalDate), 'withdrawal'),
            row(a, 'Withdrawal reason', 'withdrawalReason', esc(a.withdrawalReason), 'withdrawal')
          ]
          : []));
        h += '<div class="govuk-button-group govuk-!-margin-top-6"><a class="govuk-button" href="' + BASE + 'case">Back to costs applications</a><a class="govuk-link" href="' + BASE + 'remove?id=' + a.id + '">Remove costs application</a></div>';
        root.innerHTML = h;
        root.addEventListener('click', function (ev) {
          var t = ev
            .target
            .closest('.costs-party-toggle');
          if (!t) 
            return;
          ev.preventDefault();
          var open = t.getAttribute('aria-expanded') !== 'true';
          t
            .parentNode
            .querySelectorAll('.costs-party-more')
            .forEach(function (li) {
              li.hidden = !open;
            });
          t.setAttribute('aria-expanded', open);
          t.textContent = open
            ? t.getAttribute('data-less')
            : t.getAttribute('data-more');
        });
      }

      /* ---------- list page ---------- */
      function listPage(root) {
        var rows = all()
          .sort(function (x, y) {
            return y
              .dateMade
              .localeCompare(x.dateMade);
          })
          .map(function (a) {
            var s = status(a),
              result = a.outcome
                ? a
                  .outcome
                  .replace('Costs ', '')
                : s.text;
            result = result
              .charAt(0)
              .toUpperCase() + result.slice(1);
            var cls = a.outcome
              ? 'govuk-tag--blue'
              : s.cls;
            var party = function (arr) {
              return arr.length > 1
                ? '<ul class="govuk-list govuk-list--bullet govuk-!-margin-0">' + arr
                  .map(function (p) {
                    return '<li>' + esc(p) + '</li>';
                  })
                  .join('') + '</ul>'
                : list(arr);
            };
            return '<tr class="govuk-table__row"><td class="govuk-table__cell">' + fmt(a.dateMade) + '</td><td class="govuk-table__cell">' + party(a.applicants) + '</td><td class="govuk-table__cell">' + party(a.respondents) + '</td><td class="govuk-table__cell"><strong class="govuk-tag ' + cls + '">' + esc(result) + '</strong></td><td class="govuk-table__cell" style="white-space:nowrap"><a class="govuk-link" href="' + BASE + 'view?id=' + a.id + '">View</a> | <a class="govuk-link" href="' + BASE + 'remove?id=' + a.id + '">Remove</a></td></tr>';
          })
          .join('');
        root.innerHTML = '<table class="govuk-table"><thead class="govuk-table__head"><tr class="govuk-table__row"><th scope="col" class="govuk-table__header">Date submitted</th><th scope="col" class="govuk-table__header">Claimant</th><th scope="col" class="govuk-table__header">Respondent</th><th scope="col" class="govuk-table__header">Outcome</th><th scope="col" class="govuk-table__header">Actions</th></tr></thead><tbody class="govuk-table__body">' + (
        rows || '<tr class="govuk-table__row"><td class="govuk-table__cell" colspan="5">There are no costs applications on this case.</td></tr>') + '</tbody></table>';
      }

      /* ---------- remove page ---------- */
      function removePage(root) {
        var a = find(qs('id'));
        if (!a) {
          location.href = BASE + 'case';
          return;
        }
        root.innerHTML = '<div class="govuk-grid-row"><div class="govuk-grid-column-two-thirds">' + '<h1 class="govuk-heading-l">Are you sure you want to remove this costs application?</h1>' + '<div class="govuk-inset-text"><dl class="govuk-summary-list govuk-summary-list--no-border govuk-!-margin-bottom-0">' + [
          ['Reference', esc(a.id)],
          ['Date submitted', fmt(a.dateMade)],
          ['Applicants', list(a.applicants)],
          ['Respondents', list(a.respondents)]
        ].map(function (r) {
          return '<div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">' + r[0] + '</dt><dd class="govuk-summary-list__value">' + r[1] + '</dd></div>';
        }).join('') + '</dl></div>' + '<div class="govuk-button-group"><button class="govuk-button govuk-button--warning" id="confirm-remove" type="button">Yes, remove this costs application</button>' + '<a class="govuk-link" href="' + BASE + 'case">Cancel</a></div></div></div>';
        root
          .querySelector('#confirm-remove')
          .addEventListener('click', function () {
            saveAll(all().filter(function (x) {
              return x.id !== a.id;
            }));
            location.href = BASE + 'case';
          });
      }

      /* ---------- applicants / respondents: entry + manage ---------- */
      var PARTY = {
        applicants: {
          entry: 'Who is the applicant?',
          manage: 'Manage claimants',
          col: 'Claimant',
          next: 'respondents'
        },
        respondents: {
          entry: 'Who is the application made against?',
          manage: 'Manage respondents',
          col: 'Respondent',
          next: null
        }
      };
      function partyCtx() {
        var id = qs('id'),
          key = qs('key');
        if (!PARTY[key]) {
          location.href = BASE + 'case';
          return null;
        }
        var rec = id
          ? find(id)
          : getDraft();
        if (!rec) {
          location.href = BASE + 'case';
          return null;
        }
        return {
          id: id,
          key: key,
          rec: rec,
          cfg: PARTY[key],
          q: (
            id
            ? 'id=' + id + '&'
            : '') + 'key=' + key,
          save: function (r) {
            if (id) 
              update(r);
            else 
              setDraft(r);
            }
          };
      }
      function partyEntryPage(root) {
        var c = partyCtx();
        if (!c) 
          return;
        var list = (c.rec[c.key] || []).slice(),
          idx = qs('i') === null
            ? -1
            : parseInt(qs('i'), 10);
        var current = idx > -1
          ? list[idx]
          : '';
        var others = list.filter(function (p, i) {
          return i !== idx;
        });
        var avail = PARTIES.filter(function (p) {
          return others.indexOf(p) < 0;
        });
        var errMsgText = '',
          otherName = current && PARTIES.indexOf(current) < 0
            ? current
            : '',
          otherOn = !!otherName;
        function draw() {
          var err = errMsgText
            ? ' govuk-form-group--error'
            : '';
          root.innerHTML = '<div class="govuk-grid-row"><div class="govuk-grid-column-two-thirds">' + (
            errMsgText
            ? '<div class="govuk-error-summary" data-module="govuk-error-summary"><div role="alert"><h2 class="govuk-error-summary__title">There is a problem</h2><div class="govuk-error-summary__body"><ul class="govuk-list govuk-error-summary__list"><li><a href="#party-0">' + esc(errMsgText) + '</a></li></ul></div></div></div>'
            : '') + '<span class="govuk-caption-l">' + esc(CASE_REF) + '</span><form novalidate><div class="govuk-form-group' + err + '"><fieldset class="govuk-fieldset"><legend class="govuk-fieldset__legend govuk-fieldset__legend--l"><h1 class="govuk-fieldset__heading">' + esc(c.cfg.entry) + '</h1></legend>' + (
            errMsgText
            ? '<p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> ' + esc(errMsgText) + '</p>'
            : '') + '<div class="govuk-checkboxes" data-module="govuk-checkboxes">' + avail
            .map(function (p, i) {
              return '<div class="govuk-checkboxes__item"><input class="govuk-checkboxes__input" id="party-' + i + '" name="party" type="checkbox" value="' + esc(p) + '"' + (
                idx > -1 && p === current
                ? ' checked'
                : '') + '><label class="govuk-label govuk-checkboxes__label" for="party-' + i + '">' + esc(p) + '</label></div>';
            })
            .join('') + '<div class="govuk-checkboxes__divider">or</div><div class="govuk-checkboxes__item"><input class="govuk-checkboxes__input" id="party-other" name="party-other-check" type="checkbox" value="Yes" data-aria-controls="c-other"' + (
            otherOn
            ? ' checked'
            : '') + '><label class="govuk-label govuk-checkboxes__label" for="party-other">Not already a party on this case</label></div>' + '<div class="govuk-checkboxes__conditional govuk-checkboxes__conditional--hidden" id="c-other"><div class="govuk-form-group"><label class="govuk-label" for="party-name">Name of person or organisation</label><input class="govuk-input govuk-!-width-two-thirds" id="party-name" name="party-name" type="text" value="' + esc(otherName) + '"></div></div>' + '</div></fieldset></div><div class="govuk-button-group"><button class="govuk-button" data-module="govuk-button">Continue</button></div></form></div></div>';
          if (window.GOVUKFrontend && GOVUKFrontend.initAll) {
            try {
              GOVUKFrontend.initAll({scope: root});
            } catch (x) {}
          }
          root
            .querySelector('form')
            .addEventListener('submit', function (ev) {
              ev.preventDefault();
              var selected = Array
                .prototype
                .slice
                .call(root.querySelectorAll('input[name="party"]:checked'))
                .map(function (input) {
                  return input.value;
                });
              otherOn = root
                .querySelector('#party-other')
                .checked;
              var otherValue = otherOn
                ? root
                  .querySelector('#party-name')
                  .value
                  .trim()
                : '';
              if (otherOn && !otherValue) {
                errMsgText = 'Enter the name of the person or organisation';
                otherName = '';
                return draw();
              }
              if (otherValue) 
                selected.push(otherValue);
              if (!selected.length) {
                if (list.length) {
                  location.href = BASE + 'party-manage?' + c.q;
                  return;
                }
                errMsgText = 'Select at least one ' + (
                  c.key === 'applicants'
                  ? 'applicant'
                  : 'respondent');
                return draw();
              }
              var duplicate = selected.filter(function (p, i) {
                return selected.indexOf(p) !== i || others.indexOf(p) > -1;
              })[0];
              if (duplicate) {
                errMsgText = duplicate + ' has already been added';
                return draw();
              }
              if (idx > -1) 
                list.splice(idx, 1);
              selected.forEach(function (p) {
                list.push(p);
              });
              c.rec[c.key] = list;
              c.save(c.rec);
              location.href = BASE + 'party-manage?' + c.q;
            });
        }
        draw();
      }
      function partyManagePage(root) {
        var c = partyCtx();
        if (!c) 
          return;
        var rm = qs('remove');
        var list = c.rec[c.key] || [];
        if (rm !== null) {
          list.splice(parseInt(rm, 10), 1);
          c.rec[c.key] = list;
          c.save(c.rec);
          location.replace(BASE + 'party-manage?' + c.q);
          return;
        }
        if (!list.length) {
          location.replace(BASE + 'party-entry?' + c.q);
          return;
        }
        var rows = list
          .map(function (p, i) {
            return '<tr class="govuk-table__row"><td class="govuk-table__cell">' + esc(p) + '</td><td class="govuk-table__cell"><a class="govuk-link" href="' + BASE + 'party-entry?' + c.q + '&i=' + i + '">Change<span class="govuk-visually-hidden"> ' + esc(p) + '</span></a> | <a class="govuk-link" href="' + BASE + 'party-manage?' + c.q + '&remove=' + i + '">Remove<span class="govuk-visually-hidden"> ' + esc(p) + '</span></a></td></tr>';
          })
          .join('');
        root.innerHTML = '<div class="govuk-grid-row"><div class="govuk-grid-column-two-thirds"><span class="govuk-caption-l">' + esc(CASE_REF) + '</span><h1 class="govuk-heading-l">' + esc(c.cfg.manage) + '</h1>' + '<table class="govuk-table"><thead class="govuk-table__head"><tr class="govuk-table__row"><th scope="col" class="govuk-table__header">' + esc(c.cfg.col) + '</th><th scope="col" class="govuk-table__header">Actions</th></tr></thead><tbody class="govuk-table__body">' + rows + '</tbody></table>' + '<a class="govuk-button govuk-button--secondary" href="' + BASE + 'party-entry?' + c.q + '" role="button">Add another</a><br>' + '<a class="govuk-button" href="' + BASE + (
          c.id
          ? 'view?id=' + c.id
          : (
            c.cfg.next
            ? 'party-entry?key=' + c.cfg.next
            : 'create-application')) + '" role="button">Save and continue</a></div></div>';
      }
      function createApplication() {
        var d = getDraft();
        if (!d.dateMade || !(d.applicants || []).length || !(d.respondents || []).length) {
          location.href = BASE + 'case';
          return;
        }
        var created = Object.assign({}, d, {id: nextId()});
        var l = all();
        l.push(created);
        saveAll(l);
        setDraft({});
        location.replace(BASE + 'view?id=' + created.id + '&created=1');
      }

      /* ---------- bootstrap ---------- */
      document.addEventListener('DOMContentLoaded', function () {
        var root = document.getElementById('costs-app');
        if (!root) 
          return;
        var page = root.getAttribute('data-page');
        if (page === 'list') 
          return listPage(root);
        if (page === 'view') 
          return viewPage(root);
        if (page === 'remove') 
          return removePage(root);
        if (page === 'partyEntry') 
          return partyEntryPage(root);
        if (page === 'partyManage') 
          return partyManagePage(root);
        if (page === 'createApplication') 
          return createApplication();
        if (page === 'edit') {
          var id = qs('id'),
            p = qs('page');
          if (!PAGES[p] || !find(id)) {
            location.href = BASE + 'case';
            return;
          }
          return questionPage(root, p, {
            mode: 'edit',
            id: id,
            cancel: BASE + 'view?id=' + id,
            onSave: function (rec) {
              update(rec);
              location.href = BASE + 'view?id=' + id;
            }
          });
        }
        if (page === 'reset') {
          localStorage.removeItem(STORE);
          sessionStorage.removeItem(DRAFT);
          location.href = BASE + 'case';
          return;
        }
        // create journey steps
        var flow = {
          dateMade: 'party-entry?key=applicants'
        };
        if (page === 'dateMade' && !qs('keep')) 
          setDraft({});
        questionPage(root, page, {
          mode: 'create',
          cancel: BASE + 'case',
          onSave: function (rec) {
            var nxt = flow[page];
            if (nxt) {
              setDraft(rec);
              location.href = BASE + nxt;
              return;
            }
          }
        });
      });
    })();
  </script>
{% endraw %}